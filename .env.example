# Application
APP_ENV=development
APP_NAME=SARA-PRAGYA API
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# Web/API communication
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
CORS_ORIGINS=http://localhost:3000

# AI analysis. Never put this key in frontend environment files.
# Create a free development key at https://aistudio.google.com/app/apikey
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=sara-pragya-documents
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
REDIS_URL=redis://localhost:6379/0
